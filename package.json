{
  "name": "codex-discord",
  "version": "0.1.0",
  "private": true,
  "description": "A local Discord bridge for Codex CLI with per-channel workspaces, persistent conversations and image input.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build && node bootstrap.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node bootstrap.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:network": "node network-probe.mjs"
  },
  "dependencies": {
    "@openai/codex": "0.169.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.3",
    "global-agent": "3.0.0",
    "https-proxy-agent": "7.0.6",
    "pino": "^9.11.0",
    "pino-pretty": "^13.1.1",
    "undici": "6.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musuyin/codex-discord.git"
  }
}

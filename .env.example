# Required: create a Discord application and invite its bot to your server.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_GUILD_ID=

# Optional: default directory for newly configured channels (absolute path).
CODEX_DEFAULT_PROJECT=
# Optional JSON array of allowed absolute workspace paths. If blank, the trusted owner may bind any directory.
CODEX_ALLOWED_PROJECTS=

# Optional overrides; blank model/effort inherit the Codex defaults.
CODEX_BIN=
CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=900000
BRIDGE_ISOLATE_CODEX_CONFIG=0

# Optional HTTP CONNECT proxy, e.g. http://127.0.0.1:8080
DISCORD_PROXY_URL=
DATA_DIR=./data
LOG_LEVEL=info
